/* The Virtuademy header of the SDK's editor windows (VirtuademyWindowHeader.cs). The setup package keeps an identical
   copy of these rules and of the two logo images: change both together. */
.vd-window-header {
    align-items: center;
    padding-top: 10px;
    padding-bottom: 6px;
}

.vd-window-header__logo {
    width: 100%;
    max-width: 280px;
    height: 44px;
    background-size: contain;
}

.vd-window-header__title {
    margin-top: 2px;
    font-size: 12px;
    color: rgb(150, 150, 150);
}
