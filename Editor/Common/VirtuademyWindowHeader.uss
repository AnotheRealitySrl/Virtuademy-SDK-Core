/* The Virtuademy header of the SDK's editor windows (VirtuademyWindowHeader.cs). The setup package keeps an identical
   copy of these rules and of the two logo images: change both together. */
.vd-window-header {
    align-items: center;
    padding-top: 10px;
    padding-bottom: 6px;
}

.vd-window-header__logo {
    width: 100%;
    max-width: 280px;
    height: 44px;
    background-size: contain;
}

/* The editor theme's text colour, dimmed: grey on the dark skin, as before, and still readable on the light one, where a
   fixed grey is not. */
.vd-window-header__title {
    margin-top: 2px;
    font-size: 12px;
    color: var(--unity-colors-default-text);
    opacity: 0.7;
}
