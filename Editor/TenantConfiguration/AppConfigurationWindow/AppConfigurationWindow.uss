
.appconfig-item {
    flex-direction: row;
    margin-top: 2px;
    margin-bottom: 2px;
}

.appconfig-item-value {
    -unity-font-style: bold;
}

.section-header {
    font-size: 16px;
    -unity-font-style: bold;
}

.separator {
    background-color: rgb(0, 0, 0);
    height: 1px;
    margin-top: 5px;
    margin-bottom: 5px;
    flex-shrink: 0;
}
